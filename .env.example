APP_ENV=production
BASE_DOMAIN=seudominio.com.br
DEFAULT_WORKSPACE_SLUG=sincero
SUPER_ADMIN_TOKEN=COLE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
ENFORCE_API_TOKEN=true

# Webhooks
# Segredo global opcional aceito pelo webhook de pagamento (alem do token de API de cada workspace)
WEBHOOK_SECRET=
# Chave para assinar (HMAC-SHA256) o postback de entrega de cotas enviado a plataforma da rifa
POSTBACK_SECRET=COLE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES

# ─────────────────────────────────────────────────────────────────────────────
# Banco de Dados
# IMPORTANTE (persistencia): em producao use SEMPRE mysql. Os dados do MySQL ficam
# no servidor de banco, separados dos arquivos do site. Assim, ao subir/atualizar
# os arquivos do diretorio, NADA e perdido. Com sqlite, o banco e um ARQUIVO
# (storage/database.sqlite) que e apagado se voce sobrescrever a pasta no deploy.
# Em painel de container (Dokploy/Coolify), aponte DB_HOST para o servico do banco
# (ex.: upscale-db), e NAO use sqlite dentro do container do app (e apagado a cada deploy).
# ─────────────────────────────────────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=upscale-db
DB_PORT=3306
DB_DATABASE=u123456789_upscale
DB_USERNAME=u123456789_upscale
DB_PASSWORD=SuaSenhaForteAqui

# Opcional, apenas se DB_DRIVER=sqlite: caminho do arquivo do banco.
# Use um caminho absoluto FORA da pasta publica para o banco sobreviver aos deploys.
# DB_SQLITE_PATH=/home/u123456789/upscale_data/database.sqlite

# ─────────────────────────────────────────────────────────────────────────────
# Administrador global (super_admin que gerencia TODOS os workspaces) e login master do Hub.
# Se preenchidos, o admin e criado/atualizado automaticamente a cada migracao
# (php scripts/migrate.php) e no start do Docker. A senha fica so aqui, nunca no codigo.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=TroquePorUmaSenhaForte
ADMIN_NAME=Administrador

# Pix Sandbox / Mock
PIX_EXPIRY_MINUTES=15
MOCK_PIX_AUTOCONFIRM_SECONDS=25
SANDBOX_PIX_KEY=00000000000
SANDBOX_MERCHANT_NAME=UPSCALE SANDBOX
SANDBOX_MERCHANT_CITY=SAO PAULO
