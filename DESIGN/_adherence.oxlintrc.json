{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/finance/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Urbanist|Plus Jakarta Sans|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Urbanist, Plus Jakarta Sans, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|color|width|fill|key|ref|className|style|children)$/]",
        "message": "<AreaSeries> doesn't accept that prop. Declared props: points, color, width, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssistantComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSend|chips|models|compact|style|key|ref|className|style|children)$/]",
        "message": "<AssistantComposer> doesn't accept that prop. Declared props: placeholder, value, onChange, onSend, chips, models, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|status|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|busy|away)$/]",
        "message": "<Avatar> status must be one of 'online' | 'busy' | 'away'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, dot, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|danger|warning|neutral|brand|inverse|outline)$/]",
        "message": "<Badge> tone must be one of 'success' | 'danger' | 'warning' | 'neutral' | 'brand' | 'inverse' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|currency|onAdd|primaryAction|secondaryAction|onPrimary|onSecondary|style|key|ref|className|style|children)$/]",
        "message": "<BalanceCard> doesn't accept that prop. Declared props: label, amount, currency, onAdd, primaryAction, secondaryAction, onPrimary, onSecondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|income|expense|key|ref|className|style|children)$/]",
        "message": "<BarDatum> doesn't accept that prop. Declared props: label, income, expense."
